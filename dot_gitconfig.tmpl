[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
[alias]
	co = checkout
	d = diff
	p = add --patch
	s = status
	m = merge
	mergenc = merge --no-commit
	unstage = reset HEAD --
	last = log -1 HEAD
	ipatch = "!f() { git apply $1; git add -p; }; f"
	recent-branches = for-each-ref --sort=-committerdate --count=10 --format='%(refname:short)' refs/heads/
	co-author = !git commit --amend --no-edit --trailer \"Co-authored-by: $(git config user.name) <$(git config user.email)>\"
[user]
	name = {{ .name }}
	email = {{ .email }}
	signingkey = {{ .signingkey }}
[push]
	default = current
[core]
	editor = vim
	excludesfile = ~/.gitignore_global
	abbrev = 8

{{ if eq .chezmoi.os "darwin" -}}
[credential]
	helper = osxkeychain
{{- end }}
[diff]
	wsErrorHighlight = all
	noprefix = true
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[merge]
	tool = vimdiff
	ff = false
	conflictstyle = diff3
[mergetool]
	keepBackup = false
[mergetool "vscode"]
	cmd = code --wait $MERGED
[commit]
	gpgsign = false
[pull]
	ff = only
[gpg]
	program = gpg
{{ if lookPath "git-lfs" -}}
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
{{ end -}}

[color "diff"]
	whitespace = red reverse
[init]
	defaultBranch = main
	# templateDir = ~/.config/git/template/
[rerere]
	enabled = true

{{/* Prefer mise's gh shim so the path doesn't depend on who runs chezmoi. */ -}}
{{ $gh := lookPath "gh" -}}
{{ $ghShim := joinPath .chezmoi.homeDir ".local/share/mise/shims/gh" -}}
{{ if stat $ghShim }}{{ $gh = $ghShim }}{{ end -}}
{{ with $gh -}}
[credential "https://github.com"]
	helper =
	helper = !{{ . }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ . }} auth git-credential
{{ else -}}
{{/* Push over ssh, but keep fetching public repos over https: new machines have no ssh keys yet. */ -}}
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
{{ end }}
# Machine-specific settings that never get published.
[include]
	path = ~/.gitconfig.local
